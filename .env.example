# Скопіюйте цей файл у .env (cp .env.example .env) і за потреби змініть значення.
# Файл .env у Git не потрапляє. Опис кожної змінної: docs/docker/config.md

# Порт сайту на вашому комп'ютері: http://localhost:8080
HTTP_PORT=8080

# Ключ для підпису токенів входу (не менше 32 символів). Це демонстраційний ключ для запуску на своєму
# комп'ютері. На справжньому сервері згенеруйте свій:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=docker-demo-secret-key-change-it-before-deploy-0123456789

# production (JSON-логи) або development (читабельні логи)
APP_ENV=production
# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# true: при першому запуску заповнити порожню базу демонстраційними даними
SEED_ON_START=true

# Дозволені джерела CORS. З Nginx сайт і API на одній адресі, тож зазвичай це не потрібно
# CORS_ORIGINS='["http://localhost:8080"]'
