# Віртуальне середовище — у кожного своє, у репозиторій не потрапляє
.venv/

# Скомпільовані файли Python, створюються автоматично під час запуску
__pycache__/
*.pyc

# Особисті налаштування редактора
.vscode/

# База даних SQLite: у кожного учасника своя, вона створюється сама під час першого запуску
db.sqlite
