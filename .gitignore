# Віртуальне середовище — у кожного своє, у репозиторій не потрапляє
.venv/

# Скомпільовані файли Python, створюються автоматично під час запуску
__pycache__/
*.pyc

# Особисті налаштування редактора
.vscode/

# Секрети: справжній ключ лежить лише в backend/.env на вашому комп'ютері
.env

# База даних: у кожного своя, створюється командою python -m app.seed
backend/data/*
!backend/data/.gitkeep

# Завантажені картинки: у кожного свої
backend/media/*
!backend/media/.gitkeep

# Пакети npm: встановлюються командою npm ci з package-lock.json, у репозиторій не потрапляють
node_modules/

# Зібраний сайт (npm run build): його можна будь-коли зібрати знову з вихідного коду
frontend/dist/

# Тести (лабораторна 07): кеш pytest і файли звіту покриття створюються під час запуску
.pytest_cache/
.coverage
htmlcov/
